<?php

declare(strict_types=1);

namespace Modules\{{module}}\App\Http\Controllers;

use App\Http\Controllers\Controller;
use App\Support\SearchFilterDto;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Inertia\Inertia;
use Inertia\Response;
use Modules\{{module}}\App\Http\Requests\Store{{model}}Request;
use Modules\{{module}}\App\Http\Requests\Update{{model}}Request;
use Modules\{{module}}\App\Models\{{model}};

class {{model}}Controller extends Controller
{
    public function index(Request $request): Response
    {
        $dto = SearchFilterDto::fromRequest($request);
        $data = {{model}}::query()
            ->search($dto->search)
            ->sort($dto->sort, $dto->direction)
            ->paginate($dto->perPage)
            ->withQueryString();

        return Inertia::render('{{slug}}::index', ['data' => $data, 'filters' => $dto]);
    }

    public function create(): Response
    {
        return Inertia::render('{{slug}}::create');
    }

    public function store(Store{{model}}Request $request): RedirectResponse
    {
        {{model}}::query()->create($request->validated());

        return redirect()->route('{{kebabPlural}}.index')->with('success', '{{module}} berhasil dibuat.');
    }

    public function edit({{model}} ${{snake}}): Response
    {
        return Inertia::render('{{slug}}::edit', ['item' => ${{snake}}]);
    }

    public function update(Update{{model}}Request $request, {{model}} ${{snake}}): RedirectResponse
    {
        ${{snake}}->update($request->validated());

        return redirect()->route('{{kebabPlural}}.index')->with('success', '{{module}} berhasil diperbarui.');
    }

    public function destroy({{model}} ${{snake}}): RedirectResponse
    {
        ${{snake}}->delete();

        return back()->with('success', '{{module}} berhasil dihapus.');
    }
}
