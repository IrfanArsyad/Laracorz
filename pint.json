{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "single_quote": true,
        "no_unused_imports": true
    },
    "exclude": [
        "vendor",
        "storage",
        "bootstrap/cache",
        "node_modules"
    ]
}
