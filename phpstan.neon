includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - modules
    level: 6
    excludePaths:
        - vendor
        - storage
        - bootstrap/cache
    ignoreErrors:
        - '#PHPDoc tag @var#'
        # PHPStan 2.x replacements for the removed `checkMissingIterableValueType`
        # and `checkGenericClassInNonGenericObjectType` toggles (invalid since 2.0).
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
